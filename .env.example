# ── Nusxa ko'chirish: cp .env.example .env, keyin to'ldiring ─────────────────
# HECH QACHON haqiqiy .env ni git ga push qilmang!

# ── SmartUp API ───────────────────────────────────────────────────────────────
SMARTUP_USERNAME=your-username
SMARTUP_PASSWORD=your-password
SMARTUP_PROJECT_CODE=trade
SMARTUP_FILIAL_ID=86401

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Docker Compose da DB_HOST=smartup-db, lokal ishlatganda DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=smartup-db
DB_PORT=5432
DB_NAME=smartup

# ── ETL ───────────────────────────────────────────────────────────────────────
WRITE_EXCEL=true
EXCEL_ONLY=false
ORDERS_BEGIN_DATE=01.01.2026
LOAD_STRATEGY=upsert

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@smartup.com
PGADMIN_PASSWORD=your-pgadmin-password

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000
# Yangi kalit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=generate-a-new-key
AIRFLOW__API_AUTH__JWT_SECRET=generate-a-random-secret
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=your-airflow-password
_PIP_ADDITIONAL_REQUIREMENTS=
