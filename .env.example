# ── Copy to .env and fill in. NEVER commit the real .env. ─────────────────────

# ── SmartUp API credentials (preferred over auth.json) ────────────────────────
SMARTUP_USERNAME=admin@test
SMARTUP_PASSWORD=change-me
SMARTUP_PROJECT_CODE=trade
SMARTUP_FILIAL_ID=86401
# SMARTUP_BASE_URL=https://smartup.online
# SMARTUP_TIMEOUT=150
# SMARTUP_HTTP_RETRIES=5
# SMARTUP_HTTP_BACKOFF=1.0

# ── Target database (SmartUp warehouse) ───────────────────────────────────────
# Either set the full DB_URL, or the individual parts below.
# DB_URL=postgresql+psycopg2://postgres:password@localhost:5432/smartup
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=smartup

# ── ETL behaviour ─────────────────────────────────────────────────────────────
LOAD_STRATEGY=upsert          # upsert (idempotent) | replace (legacy)
OUTPUT_DIR=CleanedData
WRITE_EXCEL=true
ORDERS_BEGIN_DATE=01.01.2026
LOG_LEVEL=INFO
# LOG_JSON=false

# ── Airflow (docker-compose) ──────────────────────────────────────────────────
AIRFLOW_UID=50000
# Generate a fresh key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=generate-a-new-one
AIRFLOW__API_AUTH__JWT_SECRET=generate-a-random-secret
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me
